{
  "name": "playwright-ts-framework",
  "version": "1.0.0",
  "description": "A Playwright TypeScript Test Automation Framework",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "uitest:headless": "npx playwright test --project=chromium",
    "uitest:headed": "npx playwright test tests/ui --project=chromium --headed",
    "apitest": "npx playwright test tests/api",
    "report:generate": "npx playwright show-report",
    "report:allure": "allure generate ./allure-results --clean -o ./allure-report",
    "report:allure:open": "allure open ./allure-report",
    "report:html": "npx playwright show-report",
    "report:html:generate": "npx playwright test --reporter=html"
  },
  "dependencies": {
    "@playwright/test": "^1.20.0",
    "allure-playwright": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "^4.4.3"
  }
}
